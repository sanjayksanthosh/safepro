# Copy to .env and adjust. Django reads these from the environment.
# (python-dotenv is loaded automatically if installed.)

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional: switch from SQLite to PostgreSQL / MySQL
# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=safepro
# DJANGO_DB_USER=safepro
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=127.0.0.1
# DJANGO_DB_PORT=5432

# SAFEPRO_DEMO=1 uses a fake-data generator instead of live scraping (offline dev)
SAFEPRO_DEMO=1
